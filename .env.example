# Copy to .env and fill in real values. Never commit .env.
# Google Chat incoming webhook cho space nhận kết quả auto-review
GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/<SPACE_ID>/messages?key=<KEY>&token=<TOKEN>

# Webhook nội bộ lookup userId theo email (optional)
AUTO_WEBHOOK_USERID=https://auto.mservice.io/webhook/<UUID>?email=

# OIDC google-users endpoint (có default trong code, chỉ set khi cần override)
OIDC_USERS_ENDPOINT=https://oidc.mservice.io/google-users
